{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome against localhost",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}/Adc localhost",
      "sourceMaps": true,
      "file": "${workspaceFolder}/Adc localhost/index.html"
    }
  ]
}
